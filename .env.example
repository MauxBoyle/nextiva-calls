# Environment configuration for nextiva_calls
# Copy to .env for development: cp .env.example .env
EMAIL_USERNAME=your-address@gmail.com
EMAIL_APP_PASSWORD=your-google-app-password
NEXTIVA_EMAIL_SUBJECT=Your exact Nextiva report subject
# Required CSV with exactly: phone_number,agent
NEXTIVA_AGENT_LOOKUP_FILE=agent_lookup.csv
EMAIL_IMAP_SERVER=imap.gmail.com
NEXTIVA_EMAIL_SENDER=analytics@nextiva.com
NEXTIVA_ALLOWED_HOSTS=ct.nextiva.com
NEXTIVA_REPORT_TIMEOUT_SECONDS=30
NEXTIVA_OUTPUT_FILE=NextivaCallData.csv
# Optional. When blank, NextivaCallData.state.json is used beside the CSV.
NEXTIVA_STATE_FILE=
# Optional. When blank, NextivaCallData.metadata.sqlite3 is used beside the CSV.
NEXTIVA_METADATA_FILE=
# Optional. When blank, NextivaCallData.analysis.csv is used beside the CSV.
NEXTIVA_ANALYSIS_FILE=
LOG_LEVEL=DEBUG
LOG_FILE=app.log
