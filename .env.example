# Environment configuration for nextiva_calls
# Copy to .env for development: cp .env.example .env
EMAIL_USERNAME=your-address@gmail.com
EMAIL_APP_PASSWORD=your-google-app-password
# Used as the weekly-report sender, normal-send BCC recipient, and --test recipient.
NEXTIVA_EMAIL_SUBJECT=Your exact Nextiva report subject
# Required CSV with exactly: phone_number,display_name,department,destination_type
NEXTIVA_AGENT_LOOKUP_FILE=agent_lookup.csv
# Manager-maintained CSV with one date column and unique YYYY-MM-DD closure dates.
NEXTIVA_CLOSURE_DATES_FILE=closure_dates.csv
EMAIL_IMAP_SERVER=imap.gmail.com
NEXTIVA_EMAIL_SENDER=analytics@nextiva.com
NEXTIVA_ALLOWED_HOSTS=ct.nextiva.com
NEXTIVA_REPORT_TIMEOUT_SECONDS=30
NEXTIVA_OUTPUT_FILE=NextivaCallData.csv
# Optional. When blank, NextivaCallData.state.json is used beside the CSV.
NEXTIVA_STATE_FILE=
# Optional. When blank, NextivaCallData.metadata.sqlite3 is used beside the CSV.
NEXTIVA_METADATA_FILE=
# Optional. When blank, NextivaCallData.analysis.csv is used beside the CSV.
NEXTIVA_ANALYSIS_FILE=
# Optional. When blank, NextivaCallData.candidate-calls.csv is used beside the CSV.
NEXTIVA_CANDIDATE_CALLS_FILE=
# Membership uses simultaneous ringing at and after this Central-time timestamp.
NEXTIVA_MEMBERSHIP_HUNT_GROUP=Membership
# The legacy dashboard labels this source as CertHuntGroup.
NEXTIVA_CERTIFICATION_HUNT_GROUP=Certification Hunt Group
NEXTIVA_MEMBERSHIP_SIMULTANEOUS_FROM=2026-08-15T00:00:00-05:00
LOG_LEVEL=DEBUG
LOG_FILE=app.log
